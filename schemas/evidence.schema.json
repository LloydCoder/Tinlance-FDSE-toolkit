{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tinlance.com/fdse/evidence.schema.json",
  "title": "FDSE Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "sha256",
    "collected_at",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9._-]{3,80}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "pcap",
        "log",
        "json",
        "screenshot",
        "document",
        "repository_artifact",
        "scan_output",
        "binary",
        "other"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_version": {
      "type": "string",
      "maxLength": 100
    },
    "asset_id": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "maxLength": 2000
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector"
      ],
      "properties": {
        "collector": {
          "type": "string",
          "maxLength": 200
        },
        "collector_version": {
          "type": "string",
          "maxLength": 100
        },
        "command_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
