{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tinlance.com/fdse/finding.schema.json",
  "title": "FDSE Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "title",
    "severity",
    "status",
    "confidence",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^FND-[A-Z0-9._-]{3,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "ACCEPTED",
        "MITIGATED",
        "RETEST_REQUIRED",
        "CLOSED",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cvss": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "mitre_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "remediation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  }
}
