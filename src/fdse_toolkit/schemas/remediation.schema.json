{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tinlance.com/fdse/remediation.schema.json",
  "title": "FDSE Remediation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "remediation_id",
    "finding_id",
    "action",
    "priority",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "remediation_id": {
      "type": "string",
      "pattern": "^REM-[A-Z0-9._-]{3,80}$"
    },
    "finding_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "minLength": 3,
      "maxLength": 10000
    },
    "priority": {
      "type": "string",
      "enum": [
        "IMMEDIATE",
        "48_HOURS",
        "30_DAYS",
        "90_DAYS",
        "STRATEGIC"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETE",
        "ACCEPTED_RISK"
      ]
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "effort_hours": {
      "type": "number",
      "minimum": 0
    },
    "verification_method": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
