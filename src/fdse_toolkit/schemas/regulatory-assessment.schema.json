{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tinlance.com/fdse/regulatory-assessment.schema.json",
  "title": "FDSE Regulatory Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "regime",
    "jurisdiction",
    "statement_type",
    "source_url",
    "source_title",
    "effective_date",
    "applicability_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^REG-[A-Z0-9._-]{3,80}$"
    },
    "regime": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "statement_type": {
      "type": "string",
      "enum": [
        "LEGAL_REQUIREMENT",
        "GUIDANCE",
        "TINLANCE_RECOMMENDATION"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "applicability_status": {
      "type": "string",
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE",
        "REQUIRES_LEGAL_REVIEW",
        "UNKNOWN"
      ]
    },
    "requirement_topic": {
      "type": "string",
      "maxLength": 1000
    },
    "deadline": {
      "type": "string",
      "maxLength": 200
    },
    "competent_authority": {
      "type": "string",
      "maxLength": 500
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    }
  }
}
